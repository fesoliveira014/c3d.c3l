abi c3d;

root CompositeRoot {
    TextureIndex source_texture;
    SamplerIndex source_sampler;
    uint         _pad0;
    uint         _pad1;
}

root GeometryRoot {
    GpuAddress positions;
    GpuAddress normals;
    GpuAddress tangents;
    GpuAddress uv0;
    GpuAddress uv1;
    GpuAddress colors;
    GpuAddress joints;
    GpuAddress weights;
    GpuAddress morph_deltas;
    GpuAddress custom_data;
    uint       custom_stride;
    uint       vertex_count;
    uint       morph_target_count;
    uint       flags;
    uint       _pad0;
    uint       _pad1;
}

root FrameRoot {
    mat4       view;
    mat4       proj;
    mat4       view_proj;
    mat4       inv_view_proj;
    mat4       prev_view_proj;
    vec4       camera_position;
    vec4       camera_params;
    vec4       jitter_time;
    GpuAddress lights;
    GpuAddress shadows;
    GpuAddress environment;
    GpuAddress instances;
    uint       light_count;
    uint       shadow_count;
    uint       flags;
    uint       frame_index;
    vec4       ambient;
}

root DrawRoot {
    mat4       model;
    mat4       prev_model;
    vec4       normal_0;
    vec4       normal_1;
    vec4       normal_2;
    GpuAddress frame;
    GpuAddress geometry;
    GpuAddress material;
    GpuAddress skin;
    GpuAddress morph;
    GpuAddress instance_data;
    GpuAddress previous_pose;
    uint       object_id;
    uint       flags;
    uint       layers;
    uint       _pad1;
    uint       _pad2;
    uint       _pad3;
}

const uint MATERIAL_MAP_BASE_COLOR = 1;
const uint MATERIAL_MAP_METALLIC_ROUGHNESS = 2;
const uint MATERIAL_MAP_NORMAL = 4;
const uint MATERIAL_MAP_OCCLUSION = 8;
const uint MATERIAL_MAP_EMISSIVE = 16;
const uint MATERIAL_MAP_UV1_SHIFT = 5;

struct TextureMapGpu {
    TextureIndex texture_index;
    SamplerIndex sampler_index;
    vec2 uv_offset;
    vec4 uv_linear;
}

root BasicMaterialGpu {
    uint kind;
    uint flags;
    float alpha_cutoff;
    uint map_flags;
    vec4 color;
    TextureMapGpu map;
}

struct GuiVertexGpu {
    float position_x;
    float position_y;
    float uv_x;
    float uv_y;
    uint rgba;
}

root GuiVertexRoot {
    GpuAddress vertices;
    vec2 scale;
    vec2 translate;
}

root GuiFragmentRoot {
    TextureIndex source_texture;
    SamplerIndex source_sampler;
}

root CubePreviewRoot {
    TextureIndex source_texture;
    SamplerIndex source_sampler;
    float lod;
    uint face;
    uint explicit_lod;
    uint _pad0;
    uint _pad1;
    uint _pad2;
}

struct LightGpu {
    vec4 position_range;
    vec4 direction_cos_outer;
    vec4 color_intensity;
    uint kind;
    uint layers;
    float cos_inner;
    uint _pad0;
}

root StandardMaterialGpu {
    uint kind;
    uint flags;
    float alpha_cutoff;
    float metallic;
    vec4 base_color;
    vec4 emissive_strength;
    float roughness;
    float normal_scale;
    float occlusion_strength;
    uint map_flags;
    TextureMapGpu base_color_map;
    TextureMapGpu metallic_roughness_map;
    TextureMapGpu normal_map;
    TextureMapGpu occlusion_map;
    TextureMapGpu emissive_map;
}
