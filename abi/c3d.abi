root EnvironmentPrefilterRoot {
    TextureIndex source_cube;
    SamplerIndex sampler_index;
    TextureIndex output_texture;
    uint face;
    uint size;
    float roughness;
    uint _pad0;
    uint _pad1;
}

root IrradianceProjectRoot {
    TextureIndex source_cube;
    SamplerIndex sampler_index;
    uint source_size;
    uint partial_count;
    GpuAddress partials;
    u64 _pad0;
}

root IrradianceReduceRoot {
    GpuAddress partials;
    GpuAddress output_coefficients;
    uint partial_count;
    uint _pad0;
    uint _pad1;
    uint _pad2;
}

root BrdfLutRoot {
    TextureIndex output_texture;
    uint size;
    uint _pad0;
    uint _pad1;
}

const uint SKY_FOG_ATMOSPHERE = 1;
const uint SKY_FOG_HEIGHT_FOG = 2;
// 128 KiB at RGBA16F; smooth under the horizon-dense mapping, within 0.35 % of the 64-step CPU integral.
const uint SKY_TRANSMITTANCE_WIDTH = 256;
const uint SKY_TRANSMITTANCE_HEIGHT = 64;
// 8 KiB; 64 directions of 20 steps per texel, recomputed with the transmittance table only.
const uint SKY_MULTI_SCATTERING_SIZE = 32;
// 162 KiB per view, recomputed every frame; the elevation mapping is horizon-dense.
const uint SKY_VIEW_WIDTH = 192;
const uint SKY_VIEW_HEIGHT = 108;
// 256 KiB per view, recomputed every frame; slices squared toward the camera over 128 km.
const uint AERIAL_PERSPECTIVE_SIZE = 32;
const uint SKY_TABLE_GROUP_SIZE = 8;
const uint AERIAL_PERSPECTIVE_GROUP_DEPTH = 4;

root SkyFogGpu {
    vec4         sun_direction_cos_radius;
    vec4         sun_illuminance;
    vec4         rayleigh_scattering_height;
    vec4         mie;
    vec4         ozone_absorption_center;
    vec4         ground_albedo_ozone_width;
    vec4         fog_albedo_density;
    float        planet_radius;
    float        top_radius;
    float        camera_altitude;
    float        fog_base_height;
    float        fog_falloff;
    float        fog_max_distance;
    float        aerial_perspective_distance;
    uint         flags;
    TextureIndex transmittance_lut;
    TextureIndex multi_scattering_lut;
    TextureIndex sky_view_lut;
    TextureIndex aerial_perspective_lut;
    SamplerIndex lut_sampler;
    TextureIndex fog_volume;
    float        fog_anisotropy;
    uint         _pad1;
}

root SkyTableRoot {
    GpuAddress   sky_fog;
    GpuAddress   frame;
    TextureIndex output_texture;
    uint         width;
    uint         height;
    uint         face;
}

root FogPassRoot {
    GpuAddress   frame;
    TextureIndex color;
    TextureIndex depth;
    uint         width;
    uint         height;
    uint         _pad0;
    uint         _pad1;
}

// Slices of a view's fog volume, squared toward the camera; 128 halves the slice depth and doubles the memory.
const uint FOG_VOLUME_SLICES = 64;

root FogVolumeRoot {
    GpuAddress   frame;
    TextureIndex volume;
    uint         width;
    uint         height;
    uint         sun_light;
    uint         _pad0;
    uint         _pad1;
}

const uint PHYSICAL_MAP_CLEARCOAT = 1;
const uint PHYSICAL_MAP_CLEARCOAT_ROUGHNESS = 2;
const uint PHYSICAL_MAP_CLEARCOAT_NORMAL = 4;
const uint PHYSICAL_MAP_SHEEN_COLOR = 8;
const uint PHYSICAL_MAP_SHEEN_ROUGHNESS = 16;
const uint PHYSICAL_EXTENSION_MAP_SPECULAR = 1;
const uint PHYSICAL_EXTENSION_MAP_SPECULAR_COLOR = 2;
const uint PHYSICAL_EXTENSION_MAP_ANISOTROPY = 4;
const uint PHYSICAL_EXTENSION_MAP_TRANSMISSION = 8;
const uint PHYSICAL_EXTENSION_MAP_THICKNESS = 16;
const uint SHEEN_LUT_SIZE = 256;
const uint SHEEN_LUT_SAMPLES = 4096;
const uint SHEEN_PREFILTER_SAMPLES = 4096;

root StandardMaterialRoot {
    StandardMaterialGpu material;
}

root PhysicalMaterialGpu {
    StandardMaterialGpu standard;
    vec4 sheen_color_roughness;
    float clearcoat;
    float clearcoat_roughness;
    float clearcoat_normal_scale;
    uint map_flags;
    TextureMapGpu clearcoat_map;
    TextureMapGpu clearcoat_roughness_map;
    TextureMapGpu clearcoat_normal_map;
    TextureMapGpu sheen_color_map;
    TextureMapGpu sheen_roughness_map;
    vec4 specular_color_weight;
    float ior;
    uint extension_map_flags;
    float anisotropy;
    float anisotropy_rotation;
    TextureMapGpu specular_map;
    TextureMapGpu specular_color_map;
    TextureMapGpu anisotropy_map;
    vec4 attenuation_color_distance;
    float transmission;
    float thickness;
    uint _pad0;
    uint _pad1;
    TextureMapGpu transmission_map;
    TextureMapGpu thickness_map;
}

const uint CUSTOM_TEXTURE_SLOTS = 8;
const uint CUSTOM_MAP_UV1_SHIFT = 8;
const uint MATERIAL_KIND_BASIC = 0;
const uint MATERIAL_KIND_STANDARD = 1;
const uint MATERIAL_KIND_TOON = 2;
const uint MATERIAL_KIND_PHYSICAL = 3;
const uint MATERIAL_KIND_CUSTOM = 4;
const uint CUSTOM_CAPABILITY_GBUFFER = 1;
const uint CUSTOM_MATERIAL_REFERENCES = 4;

root CustomMaterialGpu {
    uint kind;
    uint flags;
    float alpha_cutoff;
    uint map_flags;
    TextureMapGpu[8] slots;
    GpuAddress parameters;
    uint capabilities;
    uint _pad0;
    GpuAddress[4] references;
}

const uint TONEMAP_NONE = 0;
const uint TONEMAP_ACES = 1;
const uint TONEMAP_AGX = 2;
const uint TONEMAP_REINHARD = 3;
const uint POST_GROUP_SIZE = 8;

struct GradeGpu {
    float exposure;
    float contrast;
    float saturation;
    uint tonemap;
    vec4 balance;
    vec4 lift;
    vec4 gamma;
    vec4 gain;
    TextureIndex lut_texture;
    SamplerIndex lut_sampler;
    float lut_scale;
    float lut_offset;
    TextureIndex bloom_texture;
    SamplerIndex bloom_sampler;
    float bloom_intensity;
    uint _pad_bloom;
    GpuAddress auto_exposure; // ExposureGpu the view's rendering wrote; zero in manual mode
    uint _pad_exposure0;
    uint _pad_exposure1;
}

root GradeRoot {
    TextureIndex input_texture;
    SamplerIndex sampler_index;
    TextureIndex output_texture;
    uint width;
    uint height;
    uint _pad0;
    uint _pad1;
    uint _pad2;
    GradeGpu grade;
}

root FxaaRoot {
    TextureIndex input_texture;
    SamplerIndex sampler_index;
    TextureIndex output_texture;
    uint width;
    uint height;
    uint _pad0;
    uint _pad1;
    uint _pad2;
}

root DisplayRoot {
    TextureIndex source_texture;
    SamplerIndex source_sampler;
    uint _pad0;
    uint _pad1;
    GradeGpu grade;
}

root BloomRoot {
    TextureIndex input_texture;
    SamplerIndex sampler_index;
    TextureIndex output_texture;
    uint width;
    uint height;
    uint prefilter;
    float threshold;
    float knee;
    vec2 input_texel;
    GpuAddress auto_exposure; // read by the prefilter dispatch only; zero in manual mode
}

// 1 KiB per view; 1/8 stop per bin, so a 16x light step shifts the histogram by exactly 32 bins.
// The adapt pass runs one thread per bin.
const uint EXPOSURE_HISTOGRAM_BINS = 256;
// 32 stops of luminance around mid-grey (log2 0.18 = -2.47); validation keeps every accepted target inside.
// -18 is four stops under RGBA16F's smallest normal; values above 2^14 clamp into the top bin.
const float EXPOSURE_LOG2_MIN = -18.0;
const float EXPOSURE_LOG2_MAX = 14.0;
// The smallest positive half float; a darker pixel is cleared or unlit and carries no exposure information.
const float EXPOSURE_LUMINANCE_EPSILON = 0.000000059604645;
// Pixels per metered sample along each axis; at 2560 x 1440 on an RTX 4090 stride 1 costs 0.034 ms, stride 2 0.020 ms.
const uint EXPOSURE_METER_STRIDE = 1;
// Metering threads per group side; 16 x 16 threads flush one group bin each.
const uint EXPOSURE_GROUP_SIZE = 16;

// Adapted exposure one rendering of a view wrote; grade and the bloom prefilter multiply by scale.
root ExposureGpu {
    float ev;
    float scale;
    float metered_log2;
    uint  samples; // of the last rendering that metered any; zero since a snap makes the next rendering snap
}

root ExposureHistogramGpu {
    uint[256] bins;
}

root ExposureMeterRoot {
    GpuAddress   histogram;
    TextureIndex input_texture;
    uint         width;
    uint         height;
    uint         _pad0;
}

root ExposureAdaptRoot {
    GpuAddress histogram;
    GpuAddress previous;
    GpuAddress current;
    float      elapsed;
    uint       snap;
    float      compensation_ev;
    float      min_ev;
    float      max_ev;
    float      brightening_time;
    float      darkening_time;
    float      low_percentile;
    float      high_percentile;
    uint       _pad0;
}

const uint POST_TILE_SIZE = 16;
const uint TILE_MODE_ALPHA = 0;
const uint TILE_MODE_VELOCITY = 1;
const uint DOF_PASS_COC = 0;
const uint DOF_PASS_GATHER_NEAR = 1;
const uint DOF_PASS_GATHER_FAR = 2;
const uint DOF_PASS_COMPOSITE = 3;
const uint TAA_DEBUG_NONE = 0;
const uint TAA_DEBUG_VELOCITY = 1;
const uint TAA_DEBUG_REJECTION = 2;
const uint TAA_DEBUG_HISTORY_WEIGHT = 3;
const uint TAA_DEBUG_VELOCITY_RANGE = 16;

root TileRoot {
    TextureIndex input_texture;
    TextureIndex output_texture;
    uint width;
    uint height;
    uint mode;
    uint _pad0;
    uint _pad1;
    uint _pad2;
}

root DofRoot {
    TextureIndex color_texture;
    TextureIndex depth_texture;
    SamplerIndex sampler_index;
    TextureIndex near_texture;
    TextureIndex far_texture;
    TextureIndex tile_texture;
    TextureIndex output_texture;
    uint width;
    uint height;
    uint pass;
    uint in_place;
    uint orthographic;
    float max_coc;
    float aperture_scale;
    float focus_distance;
    float proj_22;
    float proj_23;
    uint _pad0;
    vec2 half_texel;
    vec2 full_texel;
}

root VelocityRoot {
    TextureIndex depth_texture;
    SamplerIndex sampler_index;
    uint orthographic;
    float background_near_ratio;
    vec2 jitter_uv;
    vec2 _pad1;
    mat4 clip_to_previous;
}

root TaaRoot {
    TextureIndex color_texture;
    TextureIndex depth_texture;
    TextureIndex velocity_texture;
    TextureIndex history_color;
    TextureIndex history_depth;
    TextureIndex history_velocity;
    TextureIndex output_color;
    TextureIndex output_depth;
    TextureIndex output_velocity;
    TextureIndex debug_texture;
    SamplerIndex sampler_index;
    uint width;
    uint height;
    uint history_valid;
    uint orthographic;
    uint debug;
    vec2 texel;
    vec2 jitter_uv;
    float current_weight;
    float clip_gamma;
    float depth_tolerance;
    float velocity_threshold;
    float proj_22;
    float proj_23;
    vec2 _pad0;
}

root MotionBlurRoot {
    TextureIndex color_texture;
    TextureIndex depth_texture;
    TextureIndex velocity_texture;
    TextureIndex tile_texture;
    TextureIndex output_texture;
    SamplerIndex sampler_index;
    uint width;
    uint height;
    uint samples;
    float shutter;
    float max_velocity;
    uint _pad0;
    vec2 texel;
    vec2 _pad1;
}
