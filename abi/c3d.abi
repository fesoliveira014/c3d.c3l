abi c3d;

const uint SHADOW_FACE_POSITIVE_X = 0;
const uint SHADOW_FACE_NEGATIVE_X = 1;
const uint SHADOW_FACE_POSITIVE_Y = 2;
const uint SHADOW_FACE_NEGATIVE_Y = 3;
const uint SHADOW_FACE_POSITIVE_Z = 4;
const uint SHADOW_FACE_NEGATIVE_Z = 5;
const uint SHADOW_POINT_FACE_COUNT = 6;

const uint IMPOSTOR_GUTTER = 1;
const uint IMPOSTOR_TETRA_SIDE = 2;
const uint IMPOSTOR_TETRA_X_BITS = 6;
const uint IMPOSTOR_TETRA_Y_BITS = 10;
const uint IMPOSTOR_TETRA_Z_BITS = 12;
const float IMPOSTOR_POLE_LIMIT = 0.99;

root CompositeRoot {
    TextureIndex source_texture;
    SamplerIndex source_sampler;
    uint         _pad0;
    uint         _pad1;
}

root DispatchRoot {
    GpuAddress textures;
    GpuAddress parameters;
}

const uint MAX_DISPATCH_TEXTURES = 8;

struct DispatchTextureGpu {
    TextureIndex texture_index;
    SamplerIndex sampler_index;
}

root DispatchTexturesGpu {
    DispatchTextureGpu[8] slots;
}

root GeometryRoot {
    GpuAddress positions;
    GpuAddress normals;
    GpuAddress tangents;
    GpuAddress uv0;
    GpuAddress uv1;
    GpuAddress colors;
    GpuAddress joints;
    GpuAddress weights;
    GpuAddress morph_deltas;
    GpuAddress custom_data;
    uint       custom_stride;
    uint       vertex_count;
    uint       morph_target_count;
    uint       flags;
    GpuAddress indices;
}

const uint BVH_STACK_DEPTH = 32;
const uint TRACE_INSTANCE_ALPHA_MASK = 1;
const uint TRACE_INSTANCE_DOUBLE_SIDED = 2;
const uint TRACE_MASK_ALL = 1;
const uint TRACE_MASK_SHADOW_CASTER = 2;

struct BvhNodeGpu {
    float min_x;
    float min_y;
    float min_z;
    uint  left_or_first;
    float max_x;
    float max_y;
    float max_z;
    uint  count;
}

struct TraceInstanceGpu {
    GpuAddress geometry;
    GpuAddress material;
    uint       flags;
    uint       material_kind;
    uint       mask;
    uint       _pad1;
    vec4       world_to_local_0;
    vec4       world_to_local_1;
    vec4       world_to_local_2;
    vec4       local_to_world_0;
    vec4       local_to_world_1;
    vec4       local_to_world_2;
    GpuAddress nodes;
    GpuAddress primitives;
}

root SceneTraceRoot {
    GpuAddress top_nodes;
    GpuAddress instances;
    uint       instance_count;
    uint       top_node_count;
    uint       tlas_index;
    uint       _pad1;
}

const uint TRACE_POSE_GROUP_SIZE = 64;
// 128 lanes is the Vulkan 1.3 core minimum; one group walks a whole tree, level by level.
const uint TRACE_REFIT_GROUP_SIZE = 128;

root TracePoseRoot {
    GpuAddress source;
    GpuAddress posed;
    GpuAddress palette;
    GpuAddress morph;
}

root TraceRefitRoot {
    GpuAddress geometry;
    GpuAddress source_nodes;
    GpuAddress nodes;
    GpuAddress primitives;
    GpuAddress depth_starts;
    GpuAddress depth_order;
}

const uint FRAME_LIGHTS_CLUSTERED = 1;
const uint FRAME_TRACE_PRESENT = 2;
const uint FRAME_AO_PRESENT = 4;
const uint FRAME_SSGI_PRESENT = 8;
const uint FRAME_CLIP_PLANE = 16;
const uint CLUSTER_GROUP_SIZE = 64;
const uint MAX_DECALS = 256; // 40 KiB of 160-byte records per view per frame-slot upload; bounds the flat loop.
const uint MAX_CLUSTER_DECALS = 8; // 32 bytes of indices per cell; overflow selects the complete flat loop.
const float DECAL_FADE_BAND = 0.1; // About six degrees at the default angle; narrower angles retain full facing opacity.
const float DECAL_HALF_EXTENT = 0.5;

struct DecalGpu {
    vec4 world_to_local_0;
    vec4 world_to_local_1;
    vec4 world_to_local_2;
    vec4 local_to_world_0;
    vec4 local_to_world_1;
    vec4 local_to_world_2;
    vec4 projection_fade;
    vec4 tangent;
    vec4 weights; // base color, normal, roughness, metallic
    GpuAddress material;
    uint receiver_layers;
    float fade_cosine;
}

struct ClusterRange {
    uint count;
    uint overflow;
}

root ClusterCounterGpu {
    uint overflows;
    uint decal_overflows;
    uint _pad1;
    uint _pad2;
}

root ClusterGpu {
    GpuAddress ranges;
    GpuAddress indices;
    GpuAddress globals;
    GpuAddress counter;
    vec4 depth;
    uint tiles_x;
    uint tiles_y;
    uint depth_slices;
    uint lights_per_cluster;
    uint global_count;
    uint orthographic;
    uint _pad0;
    uint _pad1;
    mat4 view_proj;
    GpuAddress decal_ranges;
    GpuAddress decal_indices;
}

root FrameRoot {
    mat4       view;
    mat4       proj;
    mat4       view_proj;
    mat4       inv_view_proj;
    mat4       prev_view_proj;
    vec4       camera_position; // w: Camera.exposure, the manual factor; auto exposure lives in ExposureGpu
    vec4       camera_params;
    vec4       jitter_time;
    GpuAddress lights;
    GpuAddress shadows;
    GpuAddress environment;
    GpuAddress trace;
    uint       light_count;
    uint       shadow_count;
    uint       flags;
    uint       frame_index;
    vec4       ambient;
    TextureIndex scene_color;
    SamplerIndex scene_sampler;
    GpuAddress clusters;
    float      mip_bias;
    TextureIndex ao_texture;
    GpuAddress probe_volumes;
    TextureIndex ssgi_texture;
    TextureIndex scene_depth;
    float      previous_time;
    uint       _pad2;
    vec4       clip_plane;
    GpuAddress sky_fog;
    GpuAddress reflection_probes;
    vec4       origin;
    GpuAddress decals;
    uint       decal_count;
    uint       _pad3;
}

root DrawRoot {
    mat4       model;
    mat4       prev_model;
    vec4       normal_0;
    vec4       normal_1;
    vec4       normal_2;
    GpuAddress frame;
    GpuAddress geometry;
    GpuAddress material;
    GpuAddress skin;
    GpuAddress morph;
    GpuAddress instance_data;
    GpuAddress previous_pose;
    uint       object_id;
    uint       flags;
    uint       layers;
    TextureIndex sheen_lut;
    SamplerIndex sheen_sampler;
    uint       skin_stride;
    GpuAddress instance_indices;
    GpuAddress instance_effects;
    GpuAddress lod_part;
    uint       _pad0;
    uint       _pad1;
}

root LodPartGpu {
    mat4 local;
    vec4 normal_0;
    vec4 normal_1;
    vec4 normal_2;
    GpuAddress current;
    GpuAddress previous;
    uint reject_history;
    float seed;
    GpuAddress impostor;
    vec4 history_origin_delta;
    vec4 current_origin_delta;
}

root ImpostorGpu {
    vec4 bounds;
    vec4 previous_camera;
    vec4 previous_direction;
    TextureIndex atlas;
    SamplerIndex sampler_index;
    uint frames_per_side;
    uint cell_size;
}

struct LodMetadataGpu {
    uint generation;
    uint parity;
    uint _pad0;
    uint _pad1;
}

struct LodHistoryGpu {
    mat4 model;
    uint level;
    uint generation;
    uint reject_history;
    uint _pad0;
}

root PreviousPoseGpu {
    GpuAddress skin;
    GpuAddress morph;
    GpuAddress instances;
    GpuAddress positions;
}

const uint INSTANCE_CULL_GROUP_SIZE = 64;
// 128 threads is the Vulkan 1.3 core minimum; a 1,024-key block takes 8 KiB of shared memory, 2,048 (16 KiB) cuts 36 steps to 28 at 131,072.
const uint INSTANCE_SORT_GROUP_SIZE = 128;
const uint INSTANCE_SORT_BLOCK = 1024;
const uint INSTANCE_SORT_BLOCKS = 1;
const uint INSTANCE_SORT_GLOBAL = 2;
const uint INSTANCE_SORT_MERGE = 4;
const uint INSTANCE_SORT_WRITE_LIST = 8;

const uint INSTANCE_KIND_MESH = 0;
const uint INSTANCE_KIND_BILLBOARD = 1;
const uint INSTANCE_KIND_LOD = 2;
const uint LOD_SELECT = 1;
const uint LOD_CULL = 2;
const uint LOD_FINALIZE = 3;
const uint LOD_LEVEL_COUNT = 6;
const uint BILLBOARD_CAMERA = 0;
const uint BILLBOARD_DIRECTIONAL = 1;

root InstanceCullRoot {
    GpuAddress instances;
    GpuAddress visible;
    GpuAddress args;
    GpuAddress counter;
    vec4[6]    planes;
    vec4       bounds_min;
    vec4       bounds_max;
    uint       first;
    uint       count;
    GpuAddress keys;
    GpuAddress instance_effects;
    uint       kind;
    uint       _pad3;
    vec4       depth_axis;
    GpuAddress lod_current;
    GpuAddress lod_previous;
    GpuAddress lod_metadata;
    uint       _pad7;
    uint       _pad8;
    vec4[2]    lod_thresholds;
    vec4       lod_camera_bias;
    vec4       lod_projection;
    vec4       lod_reach;
    uint       lod_mode;
    uint       lod_level;
    uint       lod_parity;
    uint       lod_history_valid;
    uint       lod_level_count;
    uint       lod_count_visible;
    GpuAddress lod_source_args;
}

root InstanceSortRoot {
    GpuAddress keys;
    GpuAddress visible;
    GpuAddress args;
    uint       capacity;
    uint       stage;
    uint       distance;
    uint       mode;
}

struct InstanceGpu {
    mat4 model;
    vec4 normal_0;
    vec4 normal_1;
    vec4 normal_2;
    vec4 color;
}

struct BillboardGpu {
    vec4 position_width;
    vec4 direction_height;
    vec4 color;
    float rotation;
    uint facing;
    uint _pad0;
    uint _pad1;
}

struct SwayGpu {
    vec4  direction_amplitude;
    float phase;
    float lean;
    float waves_per_unit;
    float variation;
}

root InstanceEffectsGpu {
    SwayGpu sway;
    SwayGpu previous_sway;
    vec4    anchor;
    vec4    fade_origin;
    float   fade_start;
    float   fade_end;
    float   fade_transition;
    uint    _pad0;
}

const uint MAX_ACTIVE_MORPH_TARGETS = 8;

root MorphWeightsGpu {
    uint[8]  indices;
    float[8] weights;
    uint     count;
    uint     _pad0;
    uint     _pad1;
    uint     _pad2;
}

const uint DRAW_RECEIVE_SHADOW = 1;
const uint DRAW_ALPHA_MASK = 2;
const uint DRAW_SCREEN_SPACE_TERMS = 4;
// DrawRoot.instance_effects is read only under DRAW_SWAY or DRAW_DISTANCE_FADE; DRAW_SWAY_VERTEX_ALPHA alone reads vertex colour only.
const uint DRAW_SWAY = 8;
const uint DRAW_DISTANCE_FADE = 16;
const uint DRAW_SWAY_VERTEX_ALPHA = 32;
// Vertex history of a tracked mesh does not correspond: zero object motion, rejected history.
const uint DRAW_VERTEX_HISTORY_INVALID = 64;

const uint GBUFFER_FLAG_RECEIVE_SHADOW = 1;

root LightingResolveRoot {
