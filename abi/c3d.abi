abi c3d;

root CompositeRoot {
    TextureIndex source_texture;
    SamplerIndex source_sampler;
    uint         _pad0;
    uint         _pad1;
}

root GeometryRoot {
    GpuAddress positions;
    GpuAddress normals;
    GpuAddress tangents;
    GpuAddress uv0;
    GpuAddress uv1;
    GpuAddress colors;
    GpuAddress joints;
    GpuAddress weights;
    GpuAddress morph_deltas;
    GpuAddress custom_data;
    uint       custom_stride;
    uint       vertex_count;
    uint       morph_target_count;
    uint       flags;
    uint       _pad0;
    uint       _pad1;
}

root FrameRoot {
    mat4       view;
    mat4       proj;
    mat4       view_proj;
    mat4       inv_view_proj;
    mat4       prev_view_proj;
    vec4       camera_position;
    vec4       camera_params;
    vec4       jitter_time;
    GpuAddress lights;
    GpuAddress shadows;
    GpuAddress environment;
    GpuAddress instances;
    uint       light_count;
    uint       shadow_count;
    uint       flags;
    uint       frame_index;
    vec4       ambient;
}

root DrawRoot {
    mat4       model;
    mat4       prev_model;
    vec4       normal_0;
    vec4       normal_1;
    vec4       normal_2;
    GpuAddress frame;
    GpuAddress geometry;
    GpuAddress material;
    GpuAddress skin;
    GpuAddress morph;
    GpuAddress instance_data;
    GpuAddress previous_pose;
    uint       object_id;
    uint       flags;
    uint       layers;
    uint       _pad1;
    uint       _pad2;
    uint       _pad3;
}

root BasicMaterialGpu {
    uint  kind;
    uint  flags;
    float alpha_cutoff;
    uint  _pad0;
    vec4  color;
    TextureIndex map_texture;
    SamplerIndex map_sampler;
    uint map_uv_set;
    uint map_present;
    vec4 map_uv_row0;
    vec4 map_uv_row1;
}

struct GuiVertexGpu {
    float position_x;
    float position_y;
    float uv_x;
    float uv_y;
    uint rgba;
}

root GuiVertexRoot {
    GpuAddress vertices;
    vec2 scale;
    vec2 translate;
}

root GuiFragmentRoot {
    TextureIndex source_texture;
    SamplerIndex source_sampler;
}

root CubePreviewRoot {
    TextureIndex source_texture;
    SamplerIndex source_sampler;
    float lod;
    uint face;
    uint explicit_lod;
    uint _pad0;
    uint _pad1;
    uint _pad2;
}

struct LightGpu {
    vec4 position_range;
    vec4 direction_cos_outer;
    vec4 color_intensity;
    uint kind;
    uint layers;
    float cos_inner;
    uint _pad0;
}

root StandardMaterialGpu {
    uint kind;
    uint flags;
    float alpha_cutoff;
    float metallic;
    vec4 base_color;
    vec4 emissive_strength;
    float roughness;
    float normal_scale;
    float occlusion_strength;
    uint _pad0;
    TextureIndex base_color_texture;
    SamplerIndex base_color_sampler;
    uint base_color_uv_set;
    uint base_color_present;
    vec4 base_color_uv_row0;
    vec4 base_color_uv_row1;
    TextureIndex metallic_roughness_texture;
    SamplerIndex metallic_roughness_sampler;
    uint metallic_roughness_uv_set;
    uint metallic_roughness_present;
    vec4 metallic_roughness_uv_row0;
    vec4 metallic_roughness_uv_row1;
    TextureIndex normal_texture;
    SamplerIndex normal_sampler;
    uint normal_uv_set;
    uint normal_present;
    vec4 normal_uv_row0;
    vec4 normal_uv_row1;
    TextureIndex occlusion_texture;
    SamplerIndex occlusion_sampler;
    uint occlusion_uv_set;
    uint occlusion_present;
    vec4 occlusion_uv_row0;
    vec4 occlusion_uv_row1;
    TextureIndex emissive_texture;
    SamplerIndex emissive_sampler;
    uint emissive_uv_set;
    uint emissive_present;
    vec4 emissive_uv_row0;
    vec4 emissive_uv_row1;
}
