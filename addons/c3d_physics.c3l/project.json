{
  "langrev": "1",
  "fp-math": "strict",
  "dependency-search-paths": [ "lib", "../../lib", "../../lib/gpu.c3l/lib" ],
  "dependencies": [
    "c3d_physics",
    "c3d",
    "gpu",
    "vk",
    "vma",
    "spvreflect",
    "sdl3",
    "c3imgui",
    "c3cg",
    "b3",
    "cgltf",
    "ufbx",
    "shaderc"
  ],
  "wincrt": "static",
  "output": "build",
  "targets": {
    "physics_serial_test": {
      "type": "test",
      "sources": [ "serial_test/**" ],
      "features": [ "C3D_PHYSICS_SERIAL", "C3D_NAV_SERIAL" ],
      "dependencies": [ "c3d_physics", "c3d_nav", "c3d_serial", "c3d", "gpu", "vk", "vma", "spvreflect", "sdl3", "c3imgui", "c3cg", "b3", "cgltf", "ufbx", "shaderc" ]
    },
    "physics_serial_policy_test": {
      "type": "test",
      "sources": [ "serial_policy_test/**" ],
      "features": [ "C3D_PHYSICS_SERIAL" ],
      "dependencies": [ "c3d_physics", "c3d_serial", "c3d", "gpu", "vk", "vma", "spvreflect", "sdl3", "c3imgui", "c3cg", "b3", "cgltf", "ufbx", "shaderc" ]
    },
    "physics_gpu_test": {
      "type": "test",
      "sources": [ "gpu_test/**" ],
      "features": [ "C3D_PHYSICS_GPU" ],
      "dependencies": [ "c3d_physics", "c3d", "gpu", "vk", "vma", "spvreflect", "sdl3", "c3imgui", "c3cg", "b3", "cgltf", "ufbx", "shaderc" ]
    },
    "physics_test": {
      "type": "test",
      "sources": [ "test/*", "examples/ragdoll_getup.c3" ]
    },
    "cloth": {
      "type": "executable",
      "sources": [ "examples/cloth.c3", "examples/ragdoll_bones.c3", "examples/cloth_gpu_off.c3" ],
      "features": [ "C3D_PROFILE_GPU", "C3D_PROFILE_INTERNAL" ],
      "dependencies": [ "c3d_physics", "c3d_job", "c3d_profile", "c3d", "gpu", "vk", "vma", "spvreflect", "sdl3", "c3imgui", "c3cg", "b3", "cgltf", "ufbx", "shaderc" ]
    },
    "cloth_gpu": {
      "type": "executable",
      "sources": [ "examples/cloth.c3", "examples/ragdoll_bones.c3", "examples/cloth_gpu_on.c3" ],
      "features": [ "C3D_PROFILE_GPU", "C3D_PROFILE_INTERNAL", "C3D_PHYSICS_GPU" ],
      "dependencies": [ "c3d_physics", "c3d_job", "c3d_profile", "c3d", "gpu", "vk", "vma", "spvreflect", "sdl3", "c3imgui", "c3cg", "b3", "cgltf", "ufbx", "shaderc" ]
    },
    "breakable": {
      "type": "executable",
      "sources": [ "examples/breakable.c3", "examples/breakable_bench.c3" ],
      "dependencies": [ "c3d_physics", "c3d_job", "c3d", "gpu", "vk", "vma", "spvreflect", "sdl3", "c3imgui", "c3cg", "b3", "cgltf", "ufbx", "shaderc" ]
    },
    "physics": {
      "type": "executable",
      "sources": [ "examples/physics.c3" ]
    },
    "physics_instanced": {
      "type": "executable",
      "sources": [ "examples/physics_instanced.c3" ]
    },
    "physics_components": {
      "type": "executable",
      "sources": [ "examples/physics_components.c3" ],
      "dependencies": [ "c3d_physics", "c3d_job", "c3d", "gpu", "vk", "vma", "spvreflect", "sdl3", "c3imgui", "c3cg", "b3", "cgltf", "ufbx", "shaderc" ]
    },
    "vehicle": {
      "type": "executable",
      "sources": [ "examples/vehicle.c3" ]
    },
    "ragdoll": {
      "type": "executable",
      "sources": [ "examples/ragdoll.c3", "examples/ragdoll_getup.c3" ]
    },
    "collision_math": {
      "type": "executable",
      "sources": [ "examples/collision_math.c3", "examples/collision_math_bench.c3" ]
    }
  }
}
