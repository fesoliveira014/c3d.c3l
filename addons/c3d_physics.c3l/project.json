{
  "langrev": "1",
  "dependency-search-paths": [ "lib", "../../lib", "../../lib/gpu.c3l/lib" ],
  "dependencies": [
    "c3d_physics",
    "c3d",
    "gpu",
    "vk",
    "vma",
    "spvreflect",
    "sdl3",
    "c3imgui",
    "c3cg",
    "b3",
    "cgltf",
    "ufbx",
    "shaderc"
  ],
  "wincrt": "static",
  "output": "build",
  "targets": {
    "physics_test": {
      "type": "test",
      "sources": [ "test/**" ]
    },
    "physics": {
      "type": "executable",
      "sources": [ "examples/physics.c3" ],
      "features": [ "C3D_GUI", "C3D_STB_IMAGE" ]
    },
    "physics_instanced": {
      "type": "executable",
      "sources": [ "examples/physics_instanced.c3" ],
      "features": [ "C3D_GUI", "C3D_STB_IMAGE" ]
    },
    "physics_components": {
      "type": "executable",
      "sources": [ "examples/physics_components.c3" ],
      "features": [ "C3D_GUI", "C3D_STB_IMAGE" ]
    },
    "vehicle": {
      "type": "executable",
      "sources": [ "examples/vehicle.c3" ],
      "features": [ "C3D_GUI", "C3D_STB_IMAGE" ]
    },
    "ragdoll": {
      "type": "executable",
      "sources": [ "examples/ragdoll.c3" ],
      "features": [ "C3D_GUI", "C3D_STB_IMAGE" ]
    }
  }
}
