{
  "langrev": "1",
  "dependency-search-paths": [ "lib", "../../lib", "../../lib/gpu.c3l/lib" ],
  "dependencies": [
    "c3d_landscape",
    "c3d",
    "gpu",
    "vk",
    "vma",
    "spvreflect",
    "sdl3",
    "c3imgui",
    "c3cg",
    "cgltf",
    "ufbx",
    "shaderc"
  ],
  "wincrt": "static",
  "output": "build",
  "targets": {
    "landscape_serial_test": {
      "type": "test",
      "sources": ["serial_test/**"],
      "features": ["C3D_LANDSCAPE_SERIAL"],
      "dependencies": ["c3d_landscape", "c3d_serial", "c3d", "gpu", "vk", "vma", "spvreflect", "sdl3", "c3imgui", "c3cg", "cgltf", "ufbx", "shaderc"]
    },
    "landscape_serial_policy_test": {
      "type": "test",
      "sources": ["serial_policy_test/**"],
      "features": ["C3D_LANDSCAPE_SERIAL"],
      "dependencies": ["c3d_landscape", "c3d_serial", "c3d", "gpu", "vk", "vma", "spvreflect", "sdl3", "c3imgui", "c3cg", "cgltf", "ufbx", "shaderc"]
    },
    "landscape_test": {
      "type": "test",
      "sources": [ "test/terrain_test.c3", "test/foliage_test.c3", "test/water_test.c3", "test/simulation_test.c3", "test/setup_test.c3" ],
      "dependencies": [
        "c3d_landscape",
        "c3d_physics",
        "c3d_nav",
        "c3d",
        "gpu",
        "vk",
        "vma",
        "spvreflect",
        "sdl3",
        "c3imgui",
        "c3cg",
        "b3",
        "cgltf",
        "ufbx",
        "shaderc"
      ]
    },
    "landscape_gpu_test": {
      "type": "test",
      "sources": [ "test/spectral_test.c3" ],
      "features": ["C3D_LANDSCAPE_GPU"],
      "dependencies": ["c3d_landscape", "c3d", "gpu", "vk", "vma", "spvreflect", "sdl3", "c3imgui", "c3cg", "cgltf", "ufbx", "shaderc"]
    },
    "terrain": {
      "type": "executable",
      "sources": [ "examples/terrain.c3", "examples/landscape_ground.c3" ],
      "dependencies": [
        "c3d_landscape",
        "c3d_physics",
        "c3d",
        "gpu",
        "vk",
        "vma",
        "spvreflect",
        "sdl3",
        "c3imgui",
        "c3cg",
        "b3",
        "cgltf",
        "ufbx",
        "shaderc"
      ]
    },
    "vegetation": {
      "type": "executable",
      "sources": [ "examples/vegetation.c3", "examples/landscape_ground.c3", "examples/landscape_foliage.c3" ]
    },
    "water": {
      "type": "executable",
      "sources": [
        "examples/water.c3",
        "examples/landscape_ground.c3",
        "examples/landscape_foliage.c3",
        "examples/landscape_water_cpu.c3"
      ],
      "dependencies": [
        "c3d_landscape",
        "c3d_physics",
        "c3d",
        "gpu",
        "vk",
        "vma",
        "spvreflect",
        "sdl3",
        "c3imgui",
        "c3cg",
        "b3",
        "cgltf",
        "ufbx",
        "shaderc"
      ]
    },
    "water_gpu": {
      "type": "executable",
      "sources": [
        "examples/water.c3",
        "examples/landscape_ground.c3",
        "examples/landscape_foliage.c3",
        "examples/landscape_water_gpu.c3"
      ],
      "features": ["C3D_LANDSCAPE_GPU"],
      "dependencies": [
        "c3d_landscape",
        "c3d_physics",
        "c3d",
        "gpu",
        "vk",
        "vma",
        "spvreflect",
        "sdl3",
        "c3imgui",
        "c3cg",
        "b3",
        "cgltf",
        "ufbx",
        "shaderc"
      ]
    }
  }
}
