module c3d::serial::order_test;

import c3d::asset;
import c3d::scene;
import c3d::serial;

const char[222] EXPECTED @local = {
    0x43, 0x33, 0x44, 0x53, 0x01, 0x00, 0x00, 0x00, 0xde, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x48, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x48, 0x00, 0x00, 0x00, 0x1d, 0x00, 0x00, 0x00,
    0x02, 0x00, 0x00, 0x00, 0x65, 0x00, 0x00, 0x00, 0x4d, 0x00, 0x00, 0x00, 0x03, 0x00, 0x00, 0x00,
    0xb2, 0x00, 0x00, 0x00, 0x2c, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00, 0x05, 0x00, 0x00, 0x00,
    0x61, 0x6c, 0x70, 0x68, 0x61, 0x01, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x62, 0x65, 0x74,
    0x61, 0x01, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
    0xff, 0xff, 0xff, 0xff, 0xff, 0x00, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x72, 0x6f, 0x6f,
    0x74, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80, 0x3f, 0x00, 0x00, 0x80,
    0x3f, 0x00, 0x00, 0x80, 0x3f, 0x00, 0x00, 0x80, 0x3f, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00,
    0x00, 0x01, 0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x07, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x01, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x0b, 0x00, 0x00, 0x00,
};

struct First @private {
    uint value;
}

struct Second @private {
    uint value;
}

fn void test_component_registration_order_is_portable() @test {
    @pool() {
        AssetStore assets = asset::create_asset_store(mem, asset::default_asset_store_desc());
        defer asset::destroy_asset_store(&assets);
        Scene scene = scene::create_scene(mem, { .max_nodes = 4 });
        defer scene::destroy_scene(&scene);
        register_types(&scene);
        Node* root = scene.add_node(name: "root")!!;
        scene.add(root, (First){ .value = 7 });
        scene.add(root, (Second){ .value = 11 });
        char[] bytes = serial::write_subtree(
            allocator: tmem,
            scene: &scene,
            assets: &assets,
            root: root,
        )!!;
        assert(bytes == EXPECTED[..]);
    };
}

fn void register_first(Scene* scene) @private {
    serial::register_codec(First, {
        .name = "alpha",
        .version = 1,
        .write = &write_first,
        .read = &read_first,
    })!!;
    scene.register(First)!!;
}

fn void register_second(Scene* scene) @private {
    serial::register_codec(Second, {
        .name = "beta",
        .version = 1,
        .write = &write_second,
        .read = &read_second,
    })!!;
    scene.register(Second)!!;
}

fn void? write_first(void* component, Writer* writer, WriteContext* context) @local {
    writer.write_uint(((First*)component).value);
}

fn void? write_second(void* component, Writer* writer, WriteContext* context) @local {
    writer.write_uint(((Second*)component).value);
}

fn void? read_first(Reader* reader, ReadContext* context) @local {
    context.scene.add(context.node, (First){ .value = reader.read_uint()! });
}

fn void? read_second(Reader* reader, ReadContext* context) @local {
    context.scene.add(context.node, (Second){ .value = reader.read_uint()! });
}
