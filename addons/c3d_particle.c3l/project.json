{
  "langrev": "1",
  "dependency-search-paths": ["../../lib", "../../lib/gpu.c3l/lib"],
  "dependencies": ["c3d_particle", "c3d", "gpu", "vk", "vma", "spvreflect", "sdl3", "c3imgui", "c3cg", "cgltf", "ufbx", "shaderc"],
  "wincrt": "static",
  "output": "build",
  "targets": {
    "particle_serial_test": {
      "type": "test",
      "sources": ["serial_test/**"],
      "features": ["C3D_PARTICLE_SERIAL"],
      "dependencies": ["c3d_particle", "c3d_serial", "c3d", "gpu", "vk", "vma", "spvreflect", "sdl3", "c3imgui", "c3cg", "cgltf", "ufbx", "shaderc"]
    },
    "particle_serial_policy_test": {
      "type": "test",
      "sources": ["serial_policy_test/**"],
      "features": ["C3D_PARTICLE_SERIAL"],
      "dependencies": ["c3d_particle", "c3d_serial", "c3d", "gpu", "vk", "vma", "spvreflect", "sdl3", "c3imgui", "c3cg", "cgltf", "ufbx", "shaderc"]
    },
    "particle_test": {"type": "test", "sources": ["test/particle_test.c3", "test/material_test.c3", "test/shift_test.c3"]},
    "particles": {
      "type": "executable",
      "sources": ["examples/**"],
      "features": ["C3D_PROFILE_GPU", "C3D_PROFILE_INTERNAL"],
      "dependencies": ["c3d_particle", "c3d_profile", "c3d", "gpu", "vk", "vma", "spvreflect", "sdl3", "c3imgui", "c3cg", "cgltf", "ufbx", "shaderc"]
    }
  }
}
