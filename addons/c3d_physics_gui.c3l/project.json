{
  "langrev": "1",
  "dependency-search-paths": [
    "lib",
    "../../lib",
    "../../lib/gpu.c3l/lib"
  ],
  "dependencies": [
    "c3d_physics_gui",
    "c3d_physics",
    "c3d",
    "gpu",
    "vk",
    "vma",
    "spvreflect",
    "sdl3",
    "c3imgui",
    "c3cg",
    "b3",
    "cgltf",
    "ufbx",
    "shaderc"
  ],
  "wincrt": "static",
  "output": "build",
  "targets": {
    "physics_panel_off": {
      "type": "test",
      "sources": [
        "test/**"
      ]
    },
    "physics_panel": {
      "type": "test",
      "sources": [
        "test/**"
      ],
      "features": [
        "C3D_PHYSICS_GUI"
      ]
    },
    "physics_panel_character": {
      "type": "test",
      "sources": [
        "test/**"
      ],
      "features": [
        "C3D_PHYSICS_GUI",
        "C3D_PHYSICS_GUI_CHARACTER"
      ],
      "dependencies": [
        "c3d_physics_gui",
        "c3d_character",
        "c3d_physics",
        "c3d",
        "gpu",
        "vk",
        "vma",
        "spvreflect",
        "sdl3",
        "c3imgui",
        "c3cg",
        "b3",
        "cgltf",
        "ufbx",
        "shaderc"
      ]
    },
    "physics_inspector": {
      "type": "executable",
      "sources": [
        "examples/physics_inspector.c3",
        "../c3d_physics.c3l/examples/ragdoll_bones.c3"
      ],
      "features": [
        "C3D_PHYSICS_GUI"
      ]
    },
    "physics_inspector_character": {
      "type": "executable",
      "sources": [
        "examples/physics_inspector.c3",
        "../c3d_physics.c3l/examples/ragdoll_bones.c3"
      ],
      "features": [
        "C3D_PHYSICS_GUI",
        "C3D_PHYSICS_GUI_CHARACTER"
      ],
      "dependencies": [
        "c3d_physics_gui",
        "c3d_character",
        "c3d_physics",
        "c3d",
        "gpu",
        "vk",
        "vma",
        "spvreflect",
        "sdl3",
        "c3imgui",
        "c3cg",
        "b3",
        "cgltf",
        "ufbx",
        "shaderc"
      ]
    }
  }
}
