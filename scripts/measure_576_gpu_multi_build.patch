+fn void? vk_cmd_update_acceleration_structures(
+    CommandRecord* record,
+    gpu::AccelerationStructureBuildDesc[] descs,
+) {
+    if (descs.len == 0) return;
+    if (record.device_state == null
+        || record.device_state.acceleration_structure_operations == null
+        || record.device_state.acceleration_structure_operations.cmd_build == null) {
+        return gpu::UNSUPPORTED_FEATURE~;
+    }
+    AccelerationStructureBuildCommandOps ops = {
+        .user_data = record.device_state.acceleration_structure_operations,
+        .build = &acceleration_structure_build_command_real,
+    };
+    @pool() {
+        vk::AccelerationStructureBuildGeometryInfoKHR[] infos = alloc::new_array(
+            tmem,
+            vk::AccelerationStructureBuildGeometryInfoKHR,
+            (sz)descs.len,
+        );
+        vk::AccelerationStructureBuildRangeInfoKHR*[] range_pointers = alloc::new_array(
+            tmem,
+            vk::AccelerationStructureBuildRangeInfoKHR*,
+            (sz)descs.len,
+        );
+        uint first_geometry;
+        foreach (index, &desc : descs) {
+            PreparedAccelerationStructureBuild prepared =
+                prepare_acceleration_structure_build_mode(
+                    record:         record,
+                    desc:           desc,
+                    update:         true,
+                    indirect:       false,
+                    first_geometry: first_geometry,
+                )!;
+            infos[index] = acceleration_structure_build_info(record, &prepared, first_geometry);
+            range_pointers[index] = &record.scratch.acceleration_structure_ranges[first_geometry];
+            first_geometry += prepared.geometry_count;
+        }
+        record.scratch.acceleration_structure_geometry_count = first_geometry;
+        ops.build(
+            ops.user_data,
+            record.command_buffer,
+            (uint)descs.len,
+            infos.ptr,
+            range_pointers.ptr,
+        );
+    };
+}
+
+fn usz measure_scratch_bytes_per_geometry() {
+    return vk::AccelerationStructureGeometryKHR::size
+        + vk::AccelerationStructureBuildRangeInfoKHR::size
+        + uint::size;
+}
