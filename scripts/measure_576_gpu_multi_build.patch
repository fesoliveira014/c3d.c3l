+<* Record in-place updates of several bottom levels as one command with one
+   build info per descriptor. The command allocator must reserve at least the sum
+   of their geometry counts. The command inserts no barrier.
+   @param commands : "Live recording token outside a render pass."
+   @param descs : "Borrowed destinations, matching dynamic inputs, and update scratch."
+   @return "Success, or a recoverable command, validation, ownership, range, capacity, support, or device fault." *>
+fn void? cmd_update_acceleration_structures(CommandList* commands, AccelerationStructureBuildDesc[] descs) {
+    gpu::internal::vk::CommandRecord* record =
+        gpu::internal::recording_command(commands)!;
+    return gpu::internal::vk::vk_cmd_update_acceleration_structures(record, descs);
+}
+
+fn usz measure_scratch_bytes_per_geometry() {
+    return gpu::internal::vk::measure_scratch_bytes_per_geometry();
+}
