    TextureIndex far_texture;
    TextureIndex tile_texture;
    TextureIndex output_texture;
    uint         width;
    uint         height;
    uint         pass;
    uint         in_place;
    uint         orthographic;
    float        max_coc;
    float        aperture_scale;
    float        focus_distance;
    float        proj_22;
    float        proj_23;
    uint         _pad0;
