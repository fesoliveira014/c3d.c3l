    SamplerIndex sampler_index;
    uint         source_size;
    uint         partial_count;
    GpuAddress   partials;
    ulong        _pad0;
}
$assert IrradianceProjectRoot::size == 32;
$assert $reflect(IrradianceProjectRoot.source_cube).offset == 0;
$assert $reflect(IrradianceProjectRoot.sampler_index).offset == 4;
$assert $reflect(IrradianceProjectRoot.source_size).offset == 8;
$assert $reflect(IrradianceProjectRoot.partial_count).offset == 12;
$assert $reflect(IrradianceProjectRoot.partials).offset == 16;
$assert $reflect(IrradianceProjectRoot._pad0).offset == 24;

struct IrradianceReduceRoot {
    GpuAddress partials;
    GpuAddress output_coefficients;
    uint       partial_count;
    uint       _pad0;
    uint       _pad1;
    uint       _pad2;
}
$assert IrradianceReduceRoot::size == 32;
$assert $reflect(IrradianceReduceRoot.partials).offset == 0;
$assert $reflect(IrradianceReduceRoot.output_coefficients).offset == 8;
$assert $reflect(IrradianceReduceRoot.partial_count).offset == 16;
$assert $reflect(IrradianceReduceRoot._pad0).offset == 20;
$assert $reflect(IrradianceReduceRoot._pad1).offset == 24;
$assert $reflect(IrradianceReduceRoot._pad2).offset == 28;

struct BrdfLutRoot {
    TextureIndex output_texture;
    uint         size;
    uint         _pad0;
    uint         _pad1;
}
$assert BrdfLutRoot::size == 16;
$assert $reflect(BrdfLutRoot.output_texture).offset == 0;
$assert $reflect(BrdfLutRoot.size).offset == 4;
$assert $reflect(BrdfLutRoot._pad0).offset == 8;
$assert $reflect(BrdfLutRoot._pad1).offset == 12;

struct StandardMaterialRoot {
    StandardMaterialGpu material;
}
$assert StandardMaterialRoot::size == 224;
$assert $reflect(StandardMaterialRoot.material).offset == 0;

struct PhysicalMaterialGpu {
    StandardMaterialGpu standard;
    Vec4f               sheen_color_roughness;
    float               clearcoat;
    float               clearcoat_roughness;
    float               clearcoat_normal_scale;
    uint                map_flags;
    TextureMapGpu       clearcoat_map;
    TextureMapGpu       clearcoat_roughness_map;
    TextureMapGpu       clearcoat_normal_map;
    TextureMapGpu       sheen_color_map;
    TextureMapGpu       sheen_roughness_map;
    Vec4f               specular_color_weight;
    float               ior;
    uint                extension_map_flags;
    float               anisotropy;
    float               anisotropy_rotation;
    TextureMapGpu       specular_map;
    TextureMapGpu       specular_color_map;
    TextureMapGpu       anisotropy_map;
    Vec4f               attenuation_color_distance;
    float               transmission;
    float               thickness;
    uint                _pad0;
    uint                _pad1;
    TextureMapGpu       transmission_map;
    TextureMapGpu       thickness_map;
}
$assert PhysicalMaterialGpu::size == 640;
$assert $reflect(PhysicalMaterialGpu.standard).offset == 0;
$assert $reflect(PhysicalMaterialGpu.sheen_color_roughness).offset == 224;
$assert $reflect(PhysicalMaterialGpu.clearcoat).offset == 240;
$assert $reflect(PhysicalMaterialGpu.clearcoat_roughness).offset == 244;
$assert $reflect(PhysicalMaterialGpu.clearcoat_normal_scale).offset == 248;
$assert $reflect(PhysicalMaterialGpu.map_flags).offset == 252;
$assert $reflect(PhysicalMaterialGpu.clearcoat_map).offset == 256;
$assert $reflect(PhysicalMaterialGpu.clearcoat_roughness_map).offset == 288;
$assert $reflect(PhysicalMaterialGpu.clearcoat_normal_map).offset == 320;
$assert $reflect(PhysicalMaterialGpu.sheen_color_map).offset == 352;
$assert $reflect(PhysicalMaterialGpu.sheen_roughness_map).offset == 384;
$assert $reflect(PhysicalMaterialGpu.specular_color_weight).offset == 416;
$assert $reflect(PhysicalMaterialGpu.ior).offset == 432;
$assert $reflect(PhysicalMaterialGpu.extension_map_flags).offset == 436;
$assert $reflect(PhysicalMaterialGpu.anisotropy).offset == 440;
$assert $reflect(PhysicalMaterialGpu.anisotropy_rotation).offset == 444;
$assert $reflect(PhysicalMaterialGpu.specular_map).offset == 448;
$assert $reflect(PhysicalMaterialGpu.specular_color_map).offset == 480;
$assert $reflect(PhysicalMaterialGpu.anisotropy_map).offset == 512;
$assert $reflect(PhysicalMaterialGpu.attenuation_color_distance).offset == 544;
$assert $reflect(PhysicalMaterialGpu.transmission).offset == 560;
$assert $reflect(PhysicalMaterialGpu.thickness).offset == 564;
$assert $reflect(PhysicalMaterialGpu._pad0).offset == 568;
$assert $reflect(PhysicalMaterialGpu._pad1).offset == 572;
$assert $reflect(PhysicalMaterialGpu.transmission_map).offset == 576;
$assert $reflect(PhysicalMaterialGpu.thickness_map).offset == 608;

struct CustomMaterialGpu {
    uint             kind;
    uint             flags;
    float            alpha_cutoff;
    uint             map_flags;
    TextureMapGpu[8] slots;
    GpuAddress       parameters;
    ulong            _pad0;
}
$assert CustomMaterialGpu::size == 288;
$assert $reflect(CustomMaterialGpu.kind).offset == 0;
$assert $reflect(CustomMaterialGpu.flags).offset == 4;
$assert $reflect(CustomMaterialGpu.alpha_cutoff).offset == 8;
$assert $reflect(CustomMaterialGpu.map_flags).offset == 12;
$assert $reflect(CustomMaterialGpu.slots).offset == 16;
$assert $reflect(CustomMaterialGpu.parameters).offset == 272;
$assert $reflect(CustomMaterialGpu._pad0).offset == 280;

struct GradeGpu {
    float        exposure;
    float        contrast;
    float        saturation;
    uint         tonemap;
    Vec4f        balance;
    Vec4f        lift;
    Vec4f        gamma;
    Vec4f        gain;
    TextureIndex lut_texture;
    SamplerIndex lut_sampler;
    float        lut_scale;
    float        lut_offset;
    TextureIndex bloom_texture;
    SamplerIndex bloom_sampler;
    float        bloom_intensity;
    uint         _pad_bloom;
}
$assert GradeGpu::size == 112;
$assert $reflect(GradeGpu.exposure).offset == 0;
$assert $reflect(GradeGpu.contrast).offset == 4;
$assert $reflect(GradeGpu.saturation).offset == 8;
$assert $reflect(GradeGpu.tonemap).offset == 12;
$assert $reflect(GradeGpu.balance).offset == 16;
$assert $reflect(GradeGpu.lift).offset == 32;
$assert $reflect(GradeGpu.gamma).offset == 48;
$assert $reflect(GradeGpu.gain).offset == 64;
$assert $reflect(GradeGpu.lut_texture).offset == 80;
$assert $reflect(GradeGpu.lut_sampler).offset == 84;
$assert $reflect(GradeGpu.lut_scale).offset == 88;
$assert $reflect(GradeGpu.lut_offset).offset == 92;
$assert $reflect(GradeGpu.bloom_texture).offset == 96;
$assert $reflect(GradeGpu.bloom_sampler).offset == 100;
$assert $reflect(GradeGpu.bloom_intensity).offset == 104;
$assert $reflect(GradeGpu._pad_bloom).offset == 108;

struct GradeRoot {
    TextureIndex input_texture;
    SamplerIndex sampler_index;
    TextureIndex output_texture;
    uint         width;
    uint         height;
    uint         _pad0;
    uint         _pad1;
    uint         _pad2;
    GradeGpu     grade;
}
$assert GradeRoot::size == 144;
$assert $reflect(GradeRoot.input_texture).offset == 0;
$assert $reflect(GradeRoot.sampler_index).offset == 4;
$assert $reflect(GradeRoot.output_texture).offset == 8;
$assert $reflect(GradeRoot.width).offset == 12;
$assert $reflect(GradeRoot.height).offset == 16;
$assert $reflect(GradeRoot._pad0).offset == 20;
$assert $reflect(GradeRoot._pad1).offset == 24;
$assert $reflect(GradeRoot._pad2).offset == 28;
$assert $reflect(GradeRoot.grade).offset == 32;

